{
  "schemaVersion": 1,
  "id": "pickuphud",
  "version": "${version}",
  "name": "Pickup HUD",
  "description": "Showing items and xp orbs on pickup in HUD.",
  "authors": [
    "kotleni"
  ],
  "contact": {
    "mail" : "yavarenikya@gmail.com"
  },
  "license": "GPL-2.0",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "kotleni.pickupnotif.client.PickupnotifDataGenerator"
    ],
    "client": [
      "kotleni.pickupnotif.client.PickupnotifClient"
    ],
    "main": [
      "kotleni.pickupnotif.Pickupnotif"
    ]
  },
  "mixins": [
    "pickupnotif.mixins.json",
    {
      "config": "pickupnotif.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
